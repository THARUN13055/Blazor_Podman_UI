@page "/deployments"
@inject Blazor.Services.Persistence.IDeploymentRepository Repo
@using Blazor.Models.Persistence
@using MudBlazor

<MudText Typo="Typo.h5" Class="mb-3">Deployment History</MudText>

<MudTable Items="_deployments" Hover Dense RowClick="@OnRowClick">
    <HeaderContent>
        <MudTh>Application</MudTh>
        <MudTh>Version</MudTh>
        <MudTh>Station</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Started</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Application</MudTd>
        <MudTd>@context.Version</MudTd>
        <MudTd>@context.Station</MudTd>
        <MudTd>
            <MudChip T="string"
                     Color="@(context.Status == "Success" ? Color.Success : Color.Error)">
                @context.Status
            </MudChip>
        </MudTd>
        <MudTd>@context.StartedAt.ToLocalTime()</MudTd>
    </RowTemplate>
</MudTable>

<MudDialog @bind-IsVisible="_showDialog" MaxWidth="MaxWidth.Medium">
    <DialogContent>

        <MudText Typo="Typo.h6">Deployment Progress</MudText>

        <MudStepper Linear>
            @foreach (var step in _steps)
            {
                <MudStep Label="@step.Step.ToString()"
                         Completed="@(step.Status == "Success")"
                         Error="@(step.Status == "Failed")">
                    <MudText>Status: @step.Status</MudText>
                </MudStep>
            }
        </MudStepper>

        <MudDivider Class="my-3" />

        <MudText Typo="Typo.h6">Logs</MudText>

        <MudPaper Class="pa-2" Style="max-height:300px;overflow:auto;">
            @foreach (var log in _logs)
            {
                <div>
                    <b>@log.Timestamp.ToLocalTime()</b>
                    [@log.Level] @log.Message
                </div>
            }
        </MudPaper>

    </DialogContent>
</MudDialog>

@code {
    private IEnumerable<DeploymentEntity> _deployments = [];
    private IEnumerable<DeploymentLogEntity> _logs = [];
    private IEnumerable<DeploymentStepEntity> _steps = [];
    private bool _showDialog;

    protected override async Task OnInitializedAsync()
    {
        _deployments = await Repo.GetDeploymentsAsync();
    }

    private async Task OnRowClick(TableRowClickEventArgs<DeploymentEntity> args)
    {
        _logs = await Repo.GetLogsAsync(args.Item.Id);
        _steps = await Repo.GetStepsAsync(args.Item.Id);
        _showDialog = true;
    }
}
